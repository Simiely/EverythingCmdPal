<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\$(WindowsSdkPackageVersion)\winmd</CsWinRTWindowsMetadata>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\CmdPalLinks\Models\LinkItem.cs" Link="LinkItem.cs" />
    <Compile Include="..\..\src\CmdPalLinks\Services\LibraryStore.cs" Link="LibraryStore.cs" />
    <Compile Include="..\..\src\CmdPalLinks\Services\CsvCodec.cs" Link="CsvCodec.cs" />
    <Compile Include="..\..\src\CmdPalLinks\Services\EditorServer.cs" Link="EditorServer.cs" />
    <Compile Include="..\..\src\CmdPalLinks\HostLog.cs" Link="HostLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\CmdPalLinks\Assets\links-editor.html" Link="Assets\links-editor.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" Version="0.11.260520004" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

</Project>
